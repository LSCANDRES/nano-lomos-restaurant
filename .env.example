# ====================================================================
# RESTAURANTE - Variables de Entorno (Plantilla Limpia y Actualizada)
# ====================================================================
# Copiar este archivo a `.env` (en raíz o backend) y a `frontend/.env.local`

# ==================== 1. ENTORNO Y PUERTOS ====================
NODE_ENV=development
PORT=3007

# ==================== 2. BASE DE DATOS (PostgreSQL) ====================
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=dev1234
DB_NAME=NANOLOMOS

# URL de conexión obligatoria para Prisma ORM:
DATABASE_URL=postgresql://postgres:dev1234@localhost:5433/NANOLOMOS?schema=public

# ==================== 3. AUTENTICACIÓN (JWT) ====================
JWT_SECRET=cambiar-por-secreto-seguro-minimo-32-caracteres-en-produccion
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar-por-secreto-refresh-minimo-32-caracteres-en-produccion
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# ==================== 4. GOOGLE OAUTH 2.0 ====================
# Obtener de: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3007/api/auth/google/callback

# ==================== 5. SERVICIO DE EMAIL (SMTP) ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Nano Lomos <noreply@nanolomos.cals.com.ar>

# ==================== 6. SEGURIDAD Y RED (CORS / WebSocket) ====================
CORS_ORIGIN=http://localhost:4007
ALLOWED_ORIGINS=http://localhost:4007,http://localhost:3007
WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=5000
LOG_LEVEL=info

# ==================== 7. VARIABLES PÚBLICAS FRONTEND (Next.js) ====================
# Estas variables deben estar en `frontend/.env.local`
NEXT_PUBLIC_API_URL=http://localhost:3007/api
NEXT_PUBLIC_WS_URL=ws://localhost:3007
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
