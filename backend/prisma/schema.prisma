generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model customers {
  id         Int       @id @default(autoincrement())
  first_name String    @db.VarChar(50)
  last_name  String    @db.VarChar(50)
  phone      String?   @db.VarChar(20)
  email      String?   @db.VarChar(100)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  orders     orders[]

  @@index([email], map: "idx_customers_email")
  @@index([phone], map: "idx_customers_phone")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ingredients {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique @db.VarChar(100)
  unit               String               @db.VarChar(20)
  current_stock      Decimal?             @default(0) @db.Decimal(10, 2)
  min_stock          Decimal?             @default(0) @db.Decimal(10, 2)
  unit_cost          Decimal?             @default(0) @db.Decimal(10, 2)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @default(now()) @db.Timestamp(6)
  recipes            recipes[]
  stock_transactions stock_transactions[]

  @@index([current_stock, min_stock], map: "idx_ingredients_low_stock")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model menu_items {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(100)
  description String?
  price       Decimal       @db.Decimal(10, 2)
  category    String?       @db.VarChar(50)
  is_active   Boolean?      @default(true)
  created_at  DateTime?     @default(now()) @db.Timestamp(6)
  updated_at  DateTime?     @default(now()) @db.Timestamp(6)
  image_url   String?       @db.VarChar(500)
  order_lines order_lines[]
  recipes     recipes[]

  @@index([category], map: "idx_menu_items_category")
  @@index([is_active], map: "idx_menu_items_is_active")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_lines {
  id           Int        @id @default(autoincrement())
  order_id     Int
  menu_item_id Int
  quantity     Int
  unit_price   Decimal    @db.Decimal(10, 2)
  notes        String?
  created_at   DateTime?  @default(now()) @db.Timestamp(6)
  updated_at   DateTime?  @default(now()) @db.Timestamp(6)
  menu_items   menu_items @relation(fields: [menu_item_id], references: [id], onUpdate: NoAction)
  orders       orders     @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([menu_item_id], map: "idx_order_lines_menu_item_id")
  @@index([order_id], map: "idx_order_lines_order_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id                                   Int           @id @default(autoincrement())
  customer_id                          Int?
  table_number                         String?       @db.VarChar(20)
  table_id                             Int?
  status                               String        @default("pending") @db.VarChar(20)
  total_amount                         Decimal?      @default(0) @db.Decimal(10, 2)
  cancel_reason                        String?
  assigned_cook_id                     Int?
  created_by                           Int
  created_at                           DateTime?     @default(now()) @db.Timestamp(6)
  assigned_at                          DateTime?     @db.Timestamp(6)
  started_at                           DateTime?     @db.Timestamp(6)
  completed_at                         DateTime?     @db.Timestamp(6)
  updated_at                           DateTime?     @default(now()) @db.Timestamp(6)
  order_lines                          order_lines[]
  users_orders_assigned_cook_idTousers users?        @relation("orders_assigned_cook_idTousers", fields: [assigned_cook_id], references: [id], onUpdate: NoAction)
  users_orders_created_byTousers       users         @relation("orders_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers                            customers?    @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  tables                               tables?       @relation(fields: [table_id], references: [id], onUpdate: NoAction)

  @@index([assigned_cook_id], map: "idx_orders_assigned_cook_id")
  @@index([assigned_cook_id, status], map: "idx_orders_assigned_cook_status")
  @@index([created_at(sort: Desc)], map: "idx_orders_created_at")
  @@index([created_by], map: "idx_orders_created_by")
  @@index([customer_id, created_at(sort: Desc)], map: "idx_orders_customer_date")
  @@index([customer_id], map: "idx_orders_customer_id")
  @@index([status], map: "idx_orders_status")
  @@index([status, created_at(sort: Desc)], map: "idx_orders_status_created_at")
  @@index([table_id], map: "idx_orders_table_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model recipes {
  id                Int         @id @default(autoincrement())
  menu_item_id      Int
  ingredient_id     Int
  quantity_required Decimal     @db.Decimal(10, 3)
  instructions      String?
  created_at        DateTime?   @default(now()) @db.Timestamp(6)
  updated_at        DateTime?   @default(now()) @db.Timestamp(6)
  ingredients       ingredients @relation(fields: [ingredient_id], references: [id], onUpdate: NoAction)
  menu_items        menu_items  @relation(fields: [menu_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([menu_item_id, ingredient_id])
  @@index([menu_item_id, ingredient_id, quantity_required], map: "idx_recipes_composite")
  @@index([ingredient_id], map: "idx_recipes_ingredient_id")
  @@index([menu_item_id], map: "idx_recipes_menu_item_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model stock_transactions {
  id               Int         @id @default(autoincrement())
  ingredient_id    Int
  transaction_type String      @db.VarChar(20)
  quantity         Decimal     @db.Decimal(10, 2)
  reference_id     Int?
  reference_type   String?     @db.VarChar(50)
  notes            String?
  created_by       Int?
  created_at       DateTime?   @default(now()) @db.Timestamp(6)
  users            users?      @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ingredients      ingredients @relation(fields: [ingredient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_stock_transactions_created_at")
  @@index([ingredient_id], map: "idx_stock_transactions_ingredient_id")
  @@index([transaction_type], map: "idx_stock_transactions_type")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                                    Int                  @id @default(autoincrement())
  username                              String               @unique @db.VarChar(50)
  email                                 String?              @unique @db.VarChar(100)
  password_hash                         String               @db.VarChar(255)
  full_name                             String               @db.VarChar(100)
  role                                  String               @db.VarChar(20)
  provider                              String?              @default("local") @db.VarChar(20)
  google_id                             String?              @unique @db.VarChar(100)
  avatar_url                            String?              @db.VarChar(500)
  is_email_verified                     Boolean?             @default(false)
  last_login_at                         DateTime?            @db.Timestamp(6)
  is_active                             Boolean?             @default(true)
  created_at                            DateTime?            @default(now()) @db.Timestamp(6)
  updated_at                            DateTime?            @default(now()) @db.Timestamp(6)
  orders_orders_assigned_cook_idTousers orders[]             @relation("orders_assigned_cook_idTousers")
  orders_orders_created_byTousers       orders[]             @relation("orders_created_byTousers")
  stock_transactions                    stock_transactions[]
  login_history                         login_history[]

  @@index([is_active], map: "idx_users_is_active")
  @@index([role], map: "idx_users_role")
  @@index([username], map: "idx_users_username")
}

model login_history {
  id             Int       @id @default(autoincrement())
  user_id        Int
  email          String?   @db.VarChar(100)
  login_method   String    @db.VarChar(20)
  ip_address     String?   @db.VarChar(45)
  user_agent     String?
  status         String    @db.VarChar(20)
  failure_reason String?
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_login_history_user_id")
  @@index([created_at(sort: Desc)], map: "idx_login_history_created_at")
  @@index([status], map: "idx_login_history_status")
}

model tables {
  id         Int       @id @default(autoincrement())
  number     String    @unique @db.VarChar(20)
  name       String?   @db.VarChar(50)
  capacity   Int?      @default(4)
  position_x Int?
  position_y Int?
  is_active  Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  orders     orders[]

  @@index([is_active], map: "idx_tables_is_active")
}

